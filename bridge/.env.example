# Bridge listens on localhost only. Never expose it without auth in front.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Outbound email transport: brevo | local | none (default none = unconfigured).
# "local" points at Mailpit for safe testing; nothing real can leave.
EMAIL_PROVIDER=none

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# Visible sender. Must be a Brevo-approved sender; never defaults to the login.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

SMTP_SECURITY=starttls

# Local Mailpit relay for EMAIL_PROVIDER=local.
LOCAL_SMTP_HOST=127.0.0.1
LOCAL_SMTP_PORT=11025

# Local SQLite state. Survives restarts; never shared with Warmbly.
BRIDGE_DB_PATH=./data/bridge.sqlite

# Warmbly HTTP API. Key MUST be a scoped wmbly_* key with only
# READ_CONTACTS + WRITE_CONTACTS + READ_CAMPAIGNS + WRITE_CAMPAIGNS.
# Never SEND_CAMPAIGNS. Never commit a real key.
WARMBLY_API_BASE_URL=http://localhost:8080
WARMBLY_API_KEY=

# AI provider. Only "opencode" and "stub" (tests/local dry-runs) exist.
AI_PROVIDER=opencode

# Existing OpenCode server. The bridge connects; it does not spawn one.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
# Optional model pin as provider/model. Empty = server default.
OPENCODE_MODEL=

# Parallelism and budgets.
DEFAULT_PARALLEL_AGENTS=4
MAX_PARALLEL_AGENTS=16
DEFAULT_LEAD_TARGET=50
MAX_LEADS_PER_CAMPAIGN=500

# Resilience budgets (milliseconds / attempts).
AI_JOB_TIMEOUT_MS=300000
AI_RETRY_ATTEMPTS=3
WARMBLY_API_TIMEOUT_MS=15000
WARMBLY_RETRY_ATTEMPTS=3

# Bulk campaign sending (Phase 8). Conservative by default: pacing per queue,
# one delivery at a time, explicit timezone for day boundaries, deterministic
# follow-up offsets, and a lifetime live-send cap per queue.
DEFAULT_DAILY_SEND_LIMIT=50
MAX_DAILY_SEND_LIMIT=300
SEND_CONCURRENCY=1
SEND_TIMEZONE=UTC
FOLLOWUP_DAY_OFFSETS=3,7,12
MAX_LIVE_SENDS=3
SEND_MAX_ATTEMPTS=5

# Reply sync: recipient addresses polled per pass (Warmbly unibox reads).
REPLY_POLL_BATCH=25

# Reply inbox worker (Phase 10). One process-wide loop polls Warmbly's unibox
# for replies to bridge-sent threads; Warmbly owns mailbox sync (IMAP/Gmail/
# Graph). The bridge never opens a mailbox connection itself.
REPLY_WORKER_ENABLED=false
REPLY_WORKER_INTERVAL_MS=60000
REPLY_WORKER_LEASE_MS=300000

# Outbound send gate: disabled | local | live. Default disabled (fail closed).
# local = Warmbly test-email, or direct Mailpit when EMAIL_PROVIDER=local.
# live = Brevo only.
SEND_MODE=disabled
